{
  "name": "yotei",
  "displayName": "Yotei Theme",
  "homepage": "https://yotei.bzenky.dev/",
  "description": "A dark theme inspired by a purple/red sky at dawn.",
  "author": {
    "name": "Zenky",
    "email": "bzenky@gmail.com",
    "url": "https://bzenky.dev"
  },
  "publisher": "Zenky",
  "version": "1.3.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "publish": "vsce publish",
    "package": "npx --yes @vscode/vsce@4.1.0 package --no-dependencies --baseContentUrl https://github.com/bzenky/yotei/blob/master/visual-studio-code --baseImagesUrl https://raw.githubusercontent.com/bzenky/yotei/master/visual-studio-code",
    "publish:openvsx": "npx --yes ovsx@1.4.0 publish --no-dependencies --baseContentUrl https://github.com/bzenky/yotei/blob/master/visual-studio-code --baseImagesUrl https://raw.githubusercontent.com/bzenky/yotei/master/visual-studio-code"
  },
  "keywords": [
    "Dark Theme",
    "Tema escuro",
    "Yotei",
    "Dark Purple",
    "Dark Red",
    "Dawn"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#211925",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Yotei",
        "uiTheme": "vs-dark",
        "path": "./themes/yotei-color-theme.json"
      },
      {
        "label": "Yotei Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/yotei-midnight-color-theme.json"
      },
      {
        "label": "Yotei Dawn",
        "uiTheme": "vs",
        "path": "./themes/yotei-dawn-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bzenky/yotei",
    "directory": "visual-studio-code"
  }
}
