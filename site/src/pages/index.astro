---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemePreview from "../components/ThemePreview.astro";
import Palette from "../components/Palette.astro";
import ApplicationPreviews from "../components/ApplicationPreviews.astro";
import { applications } from "../lib/applications";
import { getThemes } from "../lib/themes";
import { samples } from "../lib/samples";
import { codeToHtml } from "shiki";

const themes = await getThemes();
const featuredTheme = themes[0];
const previews = await Promise.all(
  themes.map(async (theme) => ({
    theme,
    samples: await Promise.all(
      samples.map(async (sample) => ({
        ...sample,
        html: await codeToHtml(sample.code, {
          lang: sample.language,
          theme: theme.shikiTheme
        })
      }))
    )
  }))
);
---

<BaseLayout>
  <main class="page-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Yotei theme</p>
        <h1>Preview the dawn before installing it.</h1>
        <p>
          Explore Yotei directly in the browser with real colors loaded from the
          VS Code theme files. Install all three variants in VS Code or T3 Code,
          and explore previews for supported applications.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={`/themes/${featuredTheme.slug}`} data-full-preview-link>Open full preview</a>
          <a class="button secondary" href="https://github.com/bzenky/yotei" target="_blank" rel="noreferrer">View on GitHub</a>
        </div>
      </div>
      <div class="theme-showcase" data-theme-showcase>
        <div class="variant-picker" role="group" aria-label="Preview theme variant">
          {themes.map((theme, index) => (
            <button
              type="button"
              data-theme-variant={theme.slug}
              aria-pressed={index === 0 ? "true" : "false"}
              aria-controls={`showcase-${theme.slug}`}
            >
              {theme.name}
            </button>
          ))}
        </div>
        {previews.map(({ theme, samples }, index) => (
          <div id={`showcase-${theme.slug}`} data-theme-preview={theme.slug} hidden={index !== 0}>
            <ThemePreview theme={theme} samples={samples} compact />
          </div>
        ))}
      </div>
    </section>

    <section class="theme-gallery" aria-labelledby="themes-title">
      <div class="section-heading">
        <p>Theme variants</p>
        <h2 id="themes-title">VS Code themes</h2>
      </div>
      <div class="theme-grid">
        {themes.map((theme) => (
          <a class="theme-card" href={`/themes/${theme.slug}`}>
            <span class="theme-card-gradient" style={`background: linear-gradient(135deg, ${theme.colors["editor.background"]}, ${theme.colors["button.background"] ?? theme.syntax.keyword}, ${theme.colors["focusBorder"] ?? theme.syntax.function})`}></span>
            <span>
              <strong>{theme.name}</strong>
              <small>{theme.source} · {theme.type}</small>
            </span>
          </a>
        ))}
      </div>
    </section>

    <ApplicationPreviews applications={applications} />
    <Palette theme={featuredTheme} />
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-theme-showcase]").forEach((showcase) => {
    const buttons = showcase.querySelectorAll<HTMLButtonElement>("[data-theme-variant]");
    const previews = showcase.querySelectorAll<HTMLElement>("[data-theme-preview]");
    const fullPreviewLink = showcase.closest(".hero")?.querySelector<HTMLAnchorElement>("[data-full-preview-link]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const slug = button.dataset.themeVariant;
        const nextPreview = Array.from(previews).find((preview) => preview.dataset.themePreview === slug);
        if (!nextPreview) return;

        const activeTab = showcase.querySelector<HTMLElement>("[data-theme-preview]:not([hidden]) [data-sample-tab].active");
        const sampleIndex = activeTab?.dataset.sampleTab ?? "0";
        nextPreview.querySelector<HTMLButtonElement>(`[data-sample-tab="${sampleIndex}"]`)?.click();

        previews.forEach((preview) => {
          preview.hidden = preview !== nextPreview;
        });
        buttons.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });
        if (fullPreviewLink) fullPreviewLink.href = `/themes/${slug}`;
      });
    });
  });
</script>
