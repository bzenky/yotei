---
import type { PreviewTheme } from "../lib/themes";
import type { CodeSample } from "../lib/samples";

type HighlightedSample = CodeSample & {
  html: string;
};

interface Props {
  theme: PreviewTheme;
  samples: HighlightedSample[];
  compact?: boolean;
}

const { theme, samples, compact = false } = Astro.props;
const id = `preview-${theme.slug}-${compact ? "compact" : "full"}`;
const colors = theme.colors;
const activeSample = samples[0];
const cssVars = [
  `--editor-bg: ${colors["editor.background"]}`,
  `--editor-fg: ${colors["editor.foreground"]}`,
  `--selection: ${colors["editor.selectionBackground"]}`,
  `--sidebar-bg: ${colors["sideBar.background"] ?? colors["editor.background"]}`,
  `--titlebar-bg: ${colors["titleBar.activeBackground"] ?? colors["editor.background"]}`,
  `--status-bg: ${colors["statusBar.background"] ?? colors["editor.background"]}`,
  `--tab-active: ${colors["tab.activeForeground"] ?? theme.syntax.keyword}`,
  `--tab-inactive: ${colors["tab.inactiveForeground"] ?? theme.syntax.comment}`,
  `--accent: ${colors["focusBorder"] ?? theme.syntax.function}`,
  `--input-bg: ${colors["input.background"] ?? colors["editor.selectionBackground"]}`,
  `--terminal-bg: ${colors["terminal.background"] ?? colors["editor.background"]}`,
  `--terminal-fg: ${colors["terminal.foreground"] ?? colors["editor.foreground"]}`
].join(";");
---

<section id={id} class:list={["preview-shell", { compact }]} style={cssVars} data-preview-root>
  <div class="window-chrome">
    <span></span>
    <span></span>
    <span></span>
    <strong>{theme.name}</strong>
  </div>

  <div class="editor-frame">
    <aside class="activity-bar" aria-label="Activity bar">
      <span>⌘</span>
      <span>⌕</span>
      <span>⑂</span>
      <span>⚙</span>
    </aside>

    <aside class="sidebar" aria-label="File explorer">
      <div class="sidebar-title">EXPLORER</div>
      <details class="explorer-folder" open>
        <summary>preview</summary>
        <ul>
          {samples.map((sample, index) => (
            <li>
              <button
                class="explorer-file"
                type="button"
                data-explorer-file={index}
                aria-current={index === 0 ? "true" : undefined}
                aria-controls={`${id}-panel-${index}`}
                title={sample.filename}
              >
                {sample.filename}
              </button>
            </li>
          ))}
        </ul>
      </details>
    </aside>

    <div class="workbench">
      <div class="tabs" role="tablist" aria-label="Code samples">
        {samples.map((sample, index) => (
          <button
            class:list={["tab", { active: index === 0 }]}
            type="button"
            id={`${id}-tab-${index}`}
            role="tab"
            data-sample-tab={index}
            aria-controls={`${id}-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
            aria-selected={index === 0 ? "true" : "false"}
          >
            {sample.filename}
          </button>
        ))}
      </div>

      <div class="editor-content">
        <div class="breadcrumbs">yotei / preview / <span data-active-file>{activeSample.filename}</span></div>
        <div class="code-panels">
          {samples.map((sample, index) => (
            <div
              id={`${id}-panel-${index}`}
              class:list={["code-panel", { active: index === 0 }]}
              role="tabpanel"
              aria-labelledby={`${id}-tab-${index}`}
              data-sample-panel={index}
              data-filename={sample.filename}
            >
              <Fragment set:html={sample.html} />
            </div>
          ))}
        </div>
      </div>

      <div class="terminal-panel">
        <div class="terminal-header">Terminal</div>
        <pre><span class="prompt">➜</span> yotei git:(main) npm run build
<span class="ok">✓</span> Generated previews from theme source</pre>
      </div>

      <div class="status-bar">
        <span>{theme.name}</span>
        <span>UTF-8</span>
        <span>{theme.type}</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-preview-root]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sample-tab]"));
    const files = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-explorer-file]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-sample-panel]"));
    const activeFile = root.querySelector("[data-active-file]");

    function selectSample(index: string) {
      const panel = panels.find((item) => item.dataset.samplePanel === index);
      if (!panel) return;

      tabs.forEach((tab) => {
        const selected = tab.dataset.sampleTab === index;
        tab.classList.toggle("active", selected);
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((item) => item.classList.toggle("active", item === panel));
      files.forEach((file) => {
        if (file.dataset.explorerFile === index) {
          file.setAttribute("aria-current", "true");
          const folder = file.closest("details");
          if (folder) folder.open = true;
        } else {
          file.removeAttribute("aria-current");
        }
      });

      if (activeFile) activeFile.textContent = panel.dataset.filename ?? "preview";
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectSample(tab.dataset.sampleTab!));
      tab.addEventListener("keydown", (event) => {
        let nextIndex: number;
        switch (event.key) {
          case "ArrowRight": nextIndex = (index + 1) % tabs.length; break;
          case "ArrowLeft": nextIndex = (index - 1 + tabs.length) % tabs.length; break;
          case "Home": nextIndex = 0; break;
          case "End": nextIndex = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        tabs[nextIndex].focus();
        tabs[nextIndex].click();
      });
    });
    files.forEach((file) => {
      file.addEventListener("click", () => selectSample(file.dataset.explorerFile!));
    });
  });
</script>
